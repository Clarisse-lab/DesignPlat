# Chave da API da Anthropic (geração de texto com Claude)
ANTHROPIC_API_KEY=

# Opcional: troca o modelo usado na geração de texto
# CLAUDE_MODEL=claude-opus-5-5

# Opcional: caminho do Chromium usado para renderizar HTML → PNG.
# Se vazio, procura chromium/google-chrome no PATH.
# CHROMIUM_PATH=/usr/bin/chromium

# Opcional: chave gratuita do Pixabay (https://pixabay.com/api/docs/) para buscar fotos no Post de Feed
# PIXABAY_API_KEY=

# Chave da API de integração (/api/v1/pecas), usada pelo Escritório virtual da Mantora.
# Gere com: openssl rand -hex 32 (mínimo de 32 caracteres). Sem ela, a API fica desligada.
# A mesma chave vai nas variáveis do Escritório (Easypanel). Nunca salvar no repositório.
# DESIGN_API_KEY=

# Login da equipe e dados do Escritório (mesmo projeto Supabase "Agência Mantora").
# Com as três preenchidas, o site passa a exigir login Google (lista `equipe`); sem elas, fica aberto como antes.
# SUPABASE_URL=https://<projeto>.supabase.co
# SUPABASE_ANON_KEY=        # publishable key (sb_publishable_…)
# SUPABASE_SERVICE_ROLE_KEY= # secret key, só no servidor

# Geração de imagem com o Gemini (mesma conta do Prisma). Custo de cada imagem vai para uso_ia.
# GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image   # ou gemini-3.1-flash-image-preview / gemini-3-pro-image-preview
# LIMITE_MENSAL_IMAGENS_USD=20
# GEMINI_PRECO_IMAGEM_USD=                      # só se usar um modelo fora da tabela

# Assistente "Gerar carrossel com IA" (pauta do Motor de Conteúdo → telas). Usa ANTHROPIC_API_KEY.
# CLAUDE_MODEL_CARROSSEL=claude-sonnet-5-5
